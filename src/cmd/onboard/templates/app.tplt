
bootstrapValues:
  applications:
    {{ .AppName }}:
      destination:
        serverName: {{ .Cluster.Name }}
      info:
        - name: greeting
          value: "Hello World"
      name: {{ .AppName }}
      namespace: argocd
      projectName: {{ .ProjectName }}
      # the path inside the repository
      repoPath: {{ .Repository.Path }}
      # the developer repository where the app code can be found
      repoUrl: {{ .Repository.URL }}
