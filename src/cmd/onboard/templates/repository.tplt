
# TODO: Support public repos?

bootstrapValues:
  repositories:
    {{ .Repository.Name }}:
      name: {{ .Repository.Name }}
      projectScope: {{ .ProjectName }}
      # # This points to the secret in vault
      remoteRef:
        remoteKey: {{ .Cluster.Name }}/{{ .Cluster.Stage }}/{{ .Engine }}/repo_pat_{{ .Repository.Name }}
        remoteKeyProperty: pat
      repoType: git
      secretStoreRef:
        kind: ClusterSecretStore
        name: {{ .Cluster.Name }}-{{ .Cluster.Stage }}
      url: {{ .Repository.URL }}
      username: {{ .Repository.User }}
