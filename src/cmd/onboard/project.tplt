
bootstrapValues:
  projects:
    {{ .ProjectName }}:
      description: {{ .ProjectName }} project
      name: {{ .ProjectName }}
      namespace: argocd
      # You can add as many allowed Repos in here as you like
      # Must be added to Argo CD before
      # FIXME: strip scheme + .git; quote * ?
      sourceRepos:
        - {{ .Repository.URL }}
